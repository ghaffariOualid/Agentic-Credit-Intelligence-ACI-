# === ACI — Configuration d'environnement ===
ACI_ENV=development
ACI_LOG_LEVEL=INFO

# === Inference Gateway (T4 Colab / OpenAI-compatible) ===
# Mode: "auto" (tente vLLM Colab puis fallback mock), "vllm", "mock"
ACI_INFERENCE_MODE=auto

# URL publique du tunnel Colab (ex. https://xxxx.trycloudflare.com/v1)
ACI_VLLM_BASE_URL=
ACI_VLLM_API_KEY=aci-colab-dev-key

# Mapping des tiers vers les modèles servis sur T4 (16 Go VRAM)
ACI_MODEL_SMALL=Qwen/Qwen2.5-3B-Instruct-AWQ
ACI_MODEL_MEDIUM=Qwen/Qwen2.5-7B-Instruct-AWQ
ACI_MODEL_LARGE=Qwen/Qwen2.5-14B-Instruct-AWQ

# Optionnel : fallback externe pour le tier Large si non hébergé sur T4
ACI_LARGE_FALLBACK_BASE_URL=
ACI_LARGE_FALLBACK_API_KEY=

# Quotas & résilience Inference Gateway
ACI_INFERENCE_TIMEOUT_SECONDS=45.0
ACI_INFERENCE_MAX_RETRIES=2
ACI_INFERENCE_RATE_LIMIT_RPM=60
ACI_INFERENCE_MAX_CONCURRENT=8
